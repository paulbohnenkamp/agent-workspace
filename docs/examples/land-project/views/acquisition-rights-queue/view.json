{
  "id": "acquisition-rights-queue",
  "title": "Acquisition and Rights Queue",
  "route": "/land/acquisition-rights-queue",
  "description": "Shared operating surface for acreage strategy, acquisition, title, lease, and surface-rights work.",
  "shell": {"type": "workspace-shell", "chrome": {"leftNav": true, "topTabs": ["workspace", "my-tasks", "knowledge", "analytics"]}},
  "fields": [
    {"name": "selectedMatterId", "source": "$route.matterId"},
    {"name": "selectedMatter", "source": "projection.item_queue", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedArtifact", "source": "projection.artifact_versions", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedThread", "source": "projection.thread_index", "select": {"threadFor": "land-matter:$fields.selectedMatterId"}},
    {"name": "selectedAgents", "source": "projection.agent_activity", "select": {"relatedTo": "land-matter:$fields.selectedMatterId"}},
    {"name": "sources", "source": "projection.knowledge_links"}
  ],
  "layout": {"type": "grid", "columns": ["minmax(16rem, 19rem)", "minmax(15rem, 18rem)", "minmax(28rem, 1fr)", "minmax(17rem, 20rem)"], "gap": "0", "regions": [
    {"id": "queue", "columnStart": 1, "columnSpan": 1}, {"id": "assistant", "columnStart": 2, "columnSpan": 1}, {"id": "main", "columnStart": 3, "columnSpan": 1}, {"id": "context", "columnStart": 4, "columnSpan": 1}
  ]},
  "regions": {
    "queue": [{"component": "queue", "title": "Acquisition and Rights", "bind": {"projection": "item_queue", "selectedId": "$fields.selectedMatterId", "filter": {"track": "land-management"}}}],
    "assistant": [{"component": "summaryCard", "title": "AI Assistant", "bind": {"record": "$fields.selectedMatter", "artifact": "$fields.selectedArtifact", "showActions": false}}, {"component": "timeline", "title": "Coordination Thread", "bind": {"thread": "$fields.selectedThread"}}, {"component": "composer"}],
    "main": [{"component": "header", "bind": {"matter": "$fields.selectedMatter"}}, {"component": "tabs", "tabs": ["acquisition-assessment", "negotiation", "title-context", "surface-rights"], "bind": {"artifact": "$fields.selectedArtifact"}}, {"component": "timeline", "title": "Matter Activity", "bind": {"projection": "agent_activity", "filter": {"relatedTo": "land-matter:$fields.selectedMatterId"}}}],
    "context": [{"component": "sources", "title": "Knowledge Sources", "bind": {"sources": "$fields.sources"}}, {"component": "statusList", "title": "Agents", "bind": {"runs": "$fields.selectedAgents"}}, {"component": "actions", "title": "Actions", "actions": [{"label": "Assign Matter", "variant": "primary", "actionId": "assign-matter"}, {"label": "Request Missing Record", "actionId": "request-missing-record"}, {"label": "Escalate for Review", "actionId": "escalate-review"}], "bind": {"targetId": "$fields.selectedMatterId"}}]
  }
}
