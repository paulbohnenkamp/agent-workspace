{
  "id": "title-curative-review",
  "title": "Title and Curative Review",
  "route": "/land/title-curative-review",
  "description": "Evidence-centered review of Appalachian title findings, curative actions, and professional-review questions.",
  "shell": {"type": "workspace-shell", "header": {"component": "header"}, "chrome": {"leftNav": true, "topTabs": ["queue", "title", "rights", "activity"]}},
  "fields": [
    {"name": "selectedMatterId", "source": "$route.matterId"},
    {"name": "selectedMatter", "source": "projection.item_queue", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "titleReport", "source": "projection.artifact_versions", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "curativePlan", "source": "projection.artifact_versions", "select": {"artifactType": "curative-action-plan", "matterId": "$fields.selectedMatterId"}},
    {"name": "selectedThread", "source": "projection.thread_index", "select": {"threadFor": "land-matter:$fields.selectedMatterId"}},
    {"name": "selectedAgents", "source": "projection.agent_activity", "select": {"relatedTo": "land-matter:$fields.selectedMatterId"}},
    {"name": "sources", "source": "projection.knowledge_links"}
  ],
  "layout": {"type": "grid", "columns": ["minmax(16rem, 19rem)", "minmax(15rem, 18rem)", "minmax(28rem, 1fr)", "minmax(17rem, 20rem)"], "gap": "0", "regions": [
    {"id": "queue", "columnStart": 1, "columnSpan": 1}, {"id": "assistant", "columnStart": 2, "columnSpan": 1}, {"id": "main", "columnStart": 3, "columnSpan": 1}, {"id": "context", "columnStart": 4, "columnSpan": 1}
  ]},
  "regions": {
    "queue": [{"component": "queue", "title": "Title Matters", "bind": {"projection": "item_queue", "selectedId": "$fields.selectedMatterId", "filter": {"workType": "title"}}}],
    "assistant": [{"component": "summaryCard", "title": "AI Assistant", "bind": {"record": "$fields.selectedMatter", "artifact": "$fields.titleReport", "showActions": false}}, {"component": "timeline", "title": "Review Discussion", "bind": {"thread": "$fields.selectedThread"}}, {"component": "composer"}],
    "main": [{"component": "header", "bind": {"matter": "$fields.selectedMatter"}}, {"component": "tabs", "tabs": ["title-findings", "curative-actions", "source-documents"], "bind": {"artifact": "$fields.titleReport", "secondaryArtifact": "$fields.curativePlan"}}, {"component": "document", "title": "Professional Review Boundary", "bind": {"body": "This workspace organizes supplied records and questions. A qualified title professional or attorney must determine legal effect, marketability, and sufficiency."}}],
    "context": [{"component": "sources", "title": "Knowledge Sources", "bind": {"sources": "$fields.sources"}}, {"component": "statusList", "title": "Agents", "bind": {"runs": "$fields.selectedAgents"}}, {"component": "actions", "title": "Actions", "actions": [{"label": "Request Missing Record", "variant": "primary", "actionId": "request-missing-record"}, {"label": "Escalate for Professional Review", "actionId": "escalate-review"}, {"label": "Mark Curative Handoff Ready", "actionId": "mark-handoff-ready"}], "bind": {"targetId": "$fields.selectedMatterId"}}]
  }
}
