{
  "id": "division-order-owner-relations-queue",
  "title": "Division Orders and Owner Relations",
  "route": "/land/division-order-owner-relations-queue",
  "description": "Queue for division-order exceptions, ownership changes, royalty-owner inquiries, and suspense context.",
  "shell": {"type": "workspace-shell", "chrome": {"leftNav": true, "topTabs": ["workspace", "division-orders", "owners", "handoffs"]}},
  "fields": [
    {"name": "selectedMatterId", "source": "$route.matterId"},
    {"name": "selectedMatter", "source": "projection.item_queue", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedArtifact", "source": "projection.artifact_versions", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedThread", "source": "projection.thread_index", "select": {"threadFor": "land-matter:$fields.selectedMatterId"}},
    {"name": "selectedAgents", "source": "projection.agent_activity", "select": {"relatedTo": "land-matter:$fields.selectedMatterId"}},
    {"name": "sources", "source": "projection.knowledge_links"}
  ],
  "layout": {"type": "grid", "columns": ["minmax(16rem, 19rem)", "minmax(15rem, 18rem)", "minmax(28rem, 1fr)", "minmax(17rem, 20rem)"], "gap": "0", "regions": [
    {"id": "queue", "columnStart": 1, "columnSpan": 1}, {"id": "assistant", "columnStart": 2, "columnSpan": 1}, {"id": "main", "columnStart": 3, "columnSpan": 1}, {"id": "context", "columnStart": 4, "columnSpan": 1}
  ]},
  "regions": {
    "queue": [{"component": "queue", "title": "Division Orders and Owner Cases", "bind": {"projection": "item_queue", "selectedId": "$fields.selectedMatterId", "filter": {"track": "land-administration"}}}],
    "assistant": [{"component": "summaryCard", "title": "AI Assistant", "bind": {"record": "$fields.selectedMatter", "artifact": "$fields.selectedArtifact", "showActions": false}}, {"component": "timeline", "title": "Owner Communication", "bind": {"thread": "$fields.selectedThread"}}, {"component": "composer"}],
    "main": [{"component": "header", "bind": {"matter": "$fields.selectedMatter"}}, {"component": "tabs", "tabs": ["interest-analysis", "owner-documents", "title-change", "handoffs"], "bind": {"artifact": "$fields.selectedArtifact"}}, {"component": "document", "title": "Owner Relations Boundary", "bind": {"body": "This workspace organizes supplied ownership and communication records. It does not decide heirship, title, payment entitlement, suspense release, or accounting treatment."}}],
    "context": [{"component": "sources", "title": "Knowledge Sources", "bind": {"sources": "$fields.sources"}}, {"component": "statusList", "title": "Agents", "bind": {"runs": "$fields.selectedAgents"}}, {"component": "actions", "title": "Actions", "actions": [{"label": "Acknowledge Owner Response", "variant": "primary", "actionId": "acknowledge-owner-response"}, {"label": "Request Missing Document", "actionId": "request-missing-record"}, {"label": "Escalate for Professional Review", "actionId": "escalate-review"}], "bind": {"targetId": "$fields.selectedMatterId"}}]
  }
}
