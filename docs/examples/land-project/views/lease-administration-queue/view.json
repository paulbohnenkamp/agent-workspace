{
  "id": "lease-administration-queue",
  "title": "Lease Administration Queue",
  "route": "/land/lease-administration-queue",
  "description": "Administrative workspace for executed lease terms, obligations, expirations, continuation evidence, and exceptions.",
  "shell": {"type": "workspace-shell", "chrome": {"leftNav": true, "topTabs": ["workspace", "leases", "owners", "deadlines"]}},
  "fields": [
    {"name": "selectedMatterId", "source": "$route.matterId"},
    {"name": "selectedMatter", "source": "projection.item_queue", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedArtifact", "source": "projection.artifact_versions", "select": {"id": "$fields.selectedMatterId"}},
    {"name": "selectedThread", "source": "projection.thread_index", "select": {"threadFor": "land-matter:$fields.selectedMatterId"}},
    {"name": "selectedAgents", "source": "projection.agent_activity", "select": {"relatedTo": "land-matter:$fields.selectedMatterId"}},
    {"name": "sources", "source": "projection.knowledge_links"}
  ],
  "layout": {"type": "grid", "columns": ["minmax(16rem, 19rem)", "minmax(15rem, 18rem)", "minmax(28rem, 1fr)", "minmax(17rem, 20rem)"], "gap": "0", "regions": [
    {"id": "queue", "columnStart": 1, "columnSpan": 1}, {"id": "assistant", "columnStart": 2, "columnSpan": 1}, {"id": "main", "columnStart": 3, "columnSpan": 1}, {"id": "context", "columnStart": 4, "columnSpan": 1}
  ]},
  "regions": {
    "queue": [{"component": "queue", "title": "Lease Administration", "bind": {"projection": "item_queue", "selectedId": "$fields.selectedMatterId", "filter": {"workType": "lease"}}}],
    "assistant": [{"component": "summaryCard", "title": "AI Assistant", "bind": {"record": "$fields.selectedMatter", "artifact": "$fields.selectedArtifact", "showActions": false}}, {"component": "timeline", "title": "Administrative Activity", "bind": {"thread": "$fields.selectedThread"}}, {"component": "composer"}],
    "main": [{"component": "header", "bind": {"matter": "$fields.selectedMatter"}}, {"component": "tabs", "tabs": ["lease-record", "obligations", "expiration", "assignments"], "bind": {"artifact": "$fields.selectedArtifact"}}, {"component": "document", "title": "Administration Boundary", "bind": {"body": "This view records supplied lease terms and follow-up dates. It does not interpret ambiguous language or decide whether a right continues or expires."}}],
    "context": [{"component": "sources", "title": "Knowledge Sources", "bind": {"sources": "$fields.sources"}}, {"component": "statusList", "title": "Agents", "bind": {"runs": "$fields.selectedAgents"}}, {"component": "actions", "title": "Actions", "actions": [{"label": "Record Administrative Follow-up", "variant": "primary", "actionId": "record-administrative-follow-up"}, {"label": "Request Missing Instrument", "actionId": "request-missing-record"}, {"label": "Mark Handoff Ready", "actionId": "mark-handoff-ready"}], "bind": {"targetId": "$fields.selectedMatterId"}}]
  }
}
