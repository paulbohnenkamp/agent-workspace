{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workspace.dev/schemas/agent.schema.json",
  "allOf": [{ "$ref": "package.schema.json" }, { "type": "object", "properties": { "kind": { "const": "agent" }, "instructions": { "type": "string" }, "model": { "type": "string" }, "tools": { "$ref": "#/$defs/refs" }, "skills": { "$ref": "#/$defs/refs" }, "connectors": { "$ref": "#/$defs/refs" }, "policies": { "$ref": "#/$defs/refs" } } }],
  "$defs": { "refs": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "path": { "type": "string" } }, "additionalProperties": true } } }
}
