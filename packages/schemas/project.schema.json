{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workspace.dev/schemas/project.schema.json",
  "allOf": [{ "$ref": "package.schema.json" }, { "type": "object", "properties": { "kind": { "const": "project" }, "agents": { "$ref": "#/$defs/refs" }, "resources": { "$ref": "#/$defs/refs" }, "connectors": { "$ref": "#/$defs/refs" }, "channels": { "$ref": "#/$defs/refs" }, "schedules": { "$ref": "#/$defs/refs" } } }],
  "$defs": { "refs": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "path": { "type": "string" } }, "additionalProperties": true } } }
}
